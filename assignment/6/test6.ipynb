   ],
   "source": [
    "from sympy import symbols, diff\n",
    "def Newton(f,x0):\n",
    "    y=x0\n",
    "    for i in range(5):\n",
    "        df_dx=diff(f,x)\n",
    "        y=y-f.subs(x,y)/df_dx.subs(x,y)\n",
    "    return y\n",
    "x=symbols('x')\n",
    "f=5*x**3+3*x**2-7*x+11\n",
    "x0=1\n",
    "x=round(Newton(f,x0),3)\n",
    "print(\"x=\",x)"
   ]
  }
 ],
